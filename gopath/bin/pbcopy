#!/usr/bin/env python3
import sys
import socket

SOCKET_PATH = "/tmp/vscode-clipboard.sock"

def main():
    if sys.stdin.isatty():
        # Exit quietly if nothing is piped
        sys.exit(0)
        
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(SOCKET_PATH)
        s.sendall(sys.stdin.buffer.read())
    except FileNotFoundError:
        print(f"Error: Clipboard socket not found at {SOCKET_PATH}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Clipboard error: {e}", file=sys.stderr)
        sys.exit(1)
    finally:
        s.close()

if __name__ == "__main__":
    main()